ContentText(\"Время просыпаться!\")\n86\t                .setPriority(NotificationCompat.PRIORITY_MAX)\n87\t                .setCategory(NotificationCompat.CATEGORY_ALARM)\n88\t                .setFullScreenIntent(pendingIntent, true)\n89\t                .setAutoCancel(true)\n90\t                .build()\n91\t\n92\t            notificationManager.notify(notificationId, notification)\n93\t\n94\t            // 2. Прямой запуск AlarmRingingActivity\n95\t            //    WakeLock гарантирует пробуждение, а флаги allowLockWhileScreenOn\n96\t            //    гарантируют отображение Activity поверх заблокированного экрана\n97\t            context.startActivity(ringIntent)\n98\t\n99\t            // 3. Автоматическое перепланирование для сменных будильников\n100\t            if (shiftTypeName != null && alarmTime.isNotEmpty()) {\n101\t                try {\n102\t                    val shiftType = ShiftType.valueOf(shiftTypeName)\n103\t                    val scheduler = AlarmScheduler(context, SettingsManager(context))\n104\t\n105\t                    if (scheduler.isAlarmScheduledForShift(shiftType, brigade)) {\n106\t                        scheduler.scheduleSingleShiftAlarm(\n107\t                            type = shiftType,\n108\t                            brigade = brigade,\n109\t                            index = alarmIndex,\n110\t                            timeStr = alarmTime\n111\t                        )\n112\t                    }\n113\t                } catch (e: Exception) {\n114\t                    Log.e(TAG, \"Ошибка перепланирования: ${e.message}\", e)\n115\t                }\n116\t            }\n117\t        } catch (e: Exception) {\n118\t            Log.e(TAG, \"Ошибка в AlarmReceiver: ${e.message}\", e)\n119\t        } finally {\n120\t            wakeLock.release()\n121\t            pendingResult.finish()\n122\t        }\n123\t    }\n124\t}"
