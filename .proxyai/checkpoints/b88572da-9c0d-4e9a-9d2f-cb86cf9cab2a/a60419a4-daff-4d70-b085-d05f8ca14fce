                    "text": "1\tpackage com.example.salarynaftan\n2\t\n3\timport android.content.Intent\n4\timport android.provider.Settings\n5\timport androidx.compose.animation.*\n6\timport androidx.compose.foundation.BorderStroke\n7\timport androidx.compose.foundation.ExperimentalFoundationApi\n8\timport androidx.compose.foundation.background\n9\timport androidx.compose.foundation.border\n10\timport androidx.compose.foundation.clickable\n11\timport androidx.compose.foundation.layout.*\n12\timport androidx.compose.foundation.pager.HorizontalPager\n13\timport androidx.compose.foundation.pager.rememberPagerState\n14\timport androidx.compose.foundation.rememberScrollState\n15\timport androidx.compose.foundation.shape.RoundedCornerShape\n16\timport androidx.compose.foundation.verticalScroll\n17\timport androidx.compose.material3.*\n18\timport androidx.compose.runtime.*\n19\timport androidx.compose.ui.Alignment\n20\timport androidx.compose.ui.Modifier\n21\timport androidx.compose.ui.graphics.Color\n22\timport androidx.compose.ui.platform.LocalContext\n23\timport androidx.compose.ui.text.font.FontWeight\n24\timport androidx.compose.ui.text.style.TextAlign\n25\timport androidx.compose.ui.unit.dp\n26\timport androidx.compose.ui.unit.sp\n27\timport androidx.lifecycle.Lifecycle\n28\timport androidx.lifecycle.LifecycleEventObserver\n29\timport androidx.lifecycle.compose.LocalLifecycleOwner\n30\timport org.koin.compose.koinInject\n31\timport java.time.LocalDate\n32\timport java.time.YearMonth\n33\t\n34\t@OptIn(ExperimentalFoundationApi::class)\n35\t@Composable\n36\tfun ScheduleScreen(\n37\t    isDarkTheme: Boolean,\n38\t    onThemeChange: (Boolean) -> Unit,\n39\t    primaryColor: Color\n40\t) {\n41\t    val context = LocalContext.current\n42\t    val today = remember { LocalDate.now() }\n43\t    var visibleMonth by remember { mutableStateOf(YearMonth.from(today)) }\n44\t\n45\t    // ===== ИСПОЛЬЗУЕМ KOIN ДЛЯ ПОЛУЧЕНИЯ ЗАВИСИМОСТЕЙ =====\n46\t    val settingsManager = koinInject<SettingsManager>()\n47\t    val scheduler = koinInject<AlarmScheduler>()\n48\t    val colorSettings = koinInject<ColorSettingsManager>()\n49\t\n50\t    // Активная бригада из настроек\n51\t    val activeBrigade = remember { settingsManager.getBrigade() }\n52\t\n53\t    // Бригада для просмотра (локальная)\n54\t    var viewingBrigade by remember { mutableStateOf(activeBrigade) }\n55\t\n56\t    var exactAlarmsAllowed by remember { mutableStateOf(scheduler.canScheduleExactAlarms()) }\n57\t\n58\t    var morningColor by remember { mutableStateOf(colorSettings.getMorningColor()) }\n59\t    var dayColor by remember { mutableStateOf(colorSettings.getDayColor()) }\n60\t    var nightColor by remember { mutableStateOf(colorSettings.getNightColor()) }\n61\t    var offColor by remember { mutableStateOf(colorSettings.getOffColor()) }\n62\t\n63\t    var showExportDialog by remember { mutableStateOf(false) }\n64\t\n65\t    val lifecycleOwner = LocalLifecycleOwner.current\n66\t    DisposableEffect(lifecycleOwner) {\n67\t        val observer = LifecycleEventObserver { _, event ->\n68\t            if (event == Lifecycle.Event.ON_RESUME) {\n69\t                exactAlarmsAllowed = scheduler.canScheduleExactAlarms()\n70\t                morningColor = colorSettings.getMorningColor()\n71\t                dayColor = colorSettings.getDayColor()\n72\t                nightColor = colorSettings.getNightColor()\n73\t                offColor = colorSettings.getOffColor()\n74\t            }\n75\t        }\n76\t        lifecycleOwner.lifecycle.addObserver(observer)\n77\t        onDispose { lifecycleOwner.lifecycle.removeObserver(observer) }\n78\t    }\n79\t\n80\t    Column(\n81\t        modifier = Modifier\n82\t            .fillMaxSize()\n83\t            .padding(8.dp)\n84\t            .verticalScroll(rememberScrollState()),\n85\t        verticalArrangement = Arrangement.spacedBy(6.dp)\n86\t    ) {\n87\t        Text(\n88\t            text = \"📅 График смен\",\n89\t            fontSize = 17.sp,\n90\t            fontWeight = FontWeight.Bold,\n91\t            color = primaryColor\n92\t        )\n93\t\n94\t        if (!exactAlarmsAllowed) {\n95\t            Card(\n96\t                modifier = Modifier.fillMaxWidth(),\n97\t                colors = CardDefaults.cardColors(containerColor = Color(0x33FF5252)),\n98\t                border = BorderStroke(1.dp, Color(0xFFFF5252)),\n99\t                shape = RoundedCornerShape(10.dp)\n100\t            ) {\n101\t                Row(\n102\t                    modifier = Modifier\n103\t                        .fillMaxWidth()\n104\t                        .padding(8.dp),\n105\t                    horizontalArrangement = Arrangement.SpaceBetween,\n106\t                    verticalAlignment = Alignment.CenterVertically\n107\t                ) {\n108\t                    Text(\"⚠️ Точные будильники отключены\", fontSize = 11.sp, color = Color(0xFFFF5252))\n109\t                    Button(\n110\t                        onClick = {\n111\t                            context.startActivity(Intent(Settings.ACTION_REQUEST_SCHEDULE_EXACT_ALARM))\n112\t                        },\n113\t                        colors = ButtonDefaults.buttonColors(containerColor = primaryColor),\n114\t                        modifier = Modifier.height(32.dp)\n115\t                    ) {\n116\t                        Text(\"Включить\", color = Color.Black, fontWeight = FontWeight.Bold, fontSize = 11.sp)\n117\t                    }\n118\t                }\n119\t            }\n120\t        }\n121\t\n122\t        // Выбор бригады для просмотра\n123\t        Card(\n124\t            modifier = Modifier.fillMaxWidth(),\n125\t            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n126\t            border = BorderStroke(1.dp, Color.DarkGray),\n127\t            shape = RoundedCornerShape(12.dp)\n128\t        ) {\n129\t            Column(modifier = Modifier.padding(8.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {\n130\t                Text(\"👥 Бригада\", fontSize = 12.sp, fontWeight = FontWeight.Bold, color = primaryColor)\n131\t\n132\t                Row(\n133\t                    modifier = Modifier.fillMaxWidth(),\n134\t                    horizontalArrangement = Arrangement.spacedBy(4.dp)\n135\t                ) {\n136\t                    (1..5).forEach { num ->\n137\t                        val selected = viewingBrigade == num\n138\t                        Box(\n139\t                            modifier = Modifier\n140\t                                .weight(1f)\n141\t                                .height(28.dp)\n142\t                                .background(\n143\t                                    color = if (selected) primaryColor else Color.DarkGray,\n144\t                                    shape = RoundedCornerShape(8.dp)\n145\t                                )\n146\t                                .clickable { viewingBrigade = num },\n147\t                            contentAlignment = Alignment.Center\n148\t                        ) {\n149\t                            Text(\n150\t                                num.toString(),\n151\t                                fontWeight = FontWeight.Bold,\n152\t                                fontSize = 12.sp,\n153\t                                color = if (selected) Color.Black else Color.White\n154\t                            )\n155\t                        }\n156\t                    }\n157\t                }\n158\t            }\n159\t        }\n160\t\n161\t        // Календарь\n162\t        MonthCalendarPager(\n163\t            visibleMonth = visibleMonth,\n164\t            selectedBrigade = viewingBrigade,\n165\t            onMonthChange = { visibleMonth = it },\n166\t            morningColor = morningColor,\n167\t            dayColor = dayColor,\n168\t            nightColor = nightColor,\n169\t            offColor = offColor,\n170\t            primaryColor = primaryColor,\n171\t            onExportClick = { showExportDialog = true }\n172\t        )\n173\t\n174\t        // Итоги месяца (уменьшены)\n175\t        MonthlyStatsCard(\n176\t            visibleMonth = visibleMonth,\n177\t            selectedBrigade = viewingBrigade\n178\t        )\n179\t\n180\t        // Карточка экспорта\n181\t        Card(\n182\t            modifier = Modifier.fillMaxWidth(),\n183\t            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n184\t            border = BorderStroke(1.dp, Color.DarkGray),\n185\t            shape = RoundedCornerShape(8.dp)\n186\t        ) {\n187\t            Row(\n188\t                modifier = Modifier.fillMaxWidth().padding(horizontal = 10.dp, vertical = 6.dp),\n189\t                horizontalArrangement = Arrangement.SpaceBetween,\n190\t                verticalAlignment = Alignment.CenterVertically\n191\t            ) {\n192\t                Text(\n193\t                    text = \"📤 Экспорт\",\n194\t                    fontSize = 12.sp,\n195\t                    fontWeight = FontWeight.Bold,\n196\t                    color = primaryColor\n197\t                )\n198\t                Button(\n199\t                    onClick = { showExportDialog = true },\n200\t                    colors = ButtonDefaults.buttonColors(containerColor = primaryColor),\n201\t                    modifier = Modifier.height(28.dp)\n202\t                ) {\n203\t                    Text(\"PDF / PNG\", color = Color.Black, fontWeight = FontWeight.Bold, fontSize = 10.sp)\n204\t                }\n205\t            }\n206\t        }\n207\t    }\n208\t\n209\t    if (showExportDialog) {\n210\t        ScheduleExportDialog(\n211\t            month = visibleMonth,\n212\t            brigade = viewingBrigade,\n213\t            onDismiss = { showExportDialog = false }\n214\t        )\n215\t    }\n216\t}\n217\t\n218\t@OptIn(ExperimentalFoundationApi::class)\n219\t@Composable\n220\tfun MonthCalendarPager(\n221\t    visibleMonth: YearMonth,\n222\t    selectedBrigade: Int,\n223\t    onMonthChange: (YearMonth) -> Unit,\n224\t    morningColor: Color,\n225\t    dayColor: Color,\n226\t    nightColor: Color,\n227\t    offColor: Color,\n228\t    primaryColor: Color,\n229\t    onExportClick: () -> Unit\n230\t) {\n231\t    val today = remember { LocalDate.now() }\n232\t    val baseMonth = remember { YearMonth.now() }\n233\t    val initialPage = 1200\n234\t    val totalPages = 2400 // фиксированное значение\n235\t\n236\t    // Вычисляем целевую страницу, но обрезаем, чтобы не выйти за [0, totalPages-1]\n237\t    val currentPageTarget = remember(visibleMonth) {\n238\t        (initialPage + (visibleMonth.year - baseMonth.year) * 12 + (visibleMonth.monthValue - baseMonth.monthValue))\n239\t            .coerceIn(0, totalPages - 1)\n240\t    }\n241\t\n242\t    val pagerState = rememberPagerState(\n243\t        initialPage = currentPageTarget,\n244\t        pageCount = { totalPages } // фиксировано\n245\t    )\n246\t\n247\t    LaunchedEffect(pagerState.currentPage) {\n248\t        val newMonth = baseMonth.plusMonths((pagerState.currentPage - initialPage).toLong())\n249\t        if (newMonth != visibleMonth) {\n250\t            onMonthChange(newMonth)\n251\t        }\n252\t    }\n253\t\n254\t    LaunchedEffect(currentPageTarget) {\n255\t        if (pagerState.currentPage != currentPageTarget) {\n256\t            pagerState.animateScrollToPage(currentPageTarget)\n257\t        }\n258\t    }\n259\t\n260\t    Card(\n261\t        modifier = Modifier.fillMaxWidth(),\n262\t        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n263\t        border = BorderStroke(1.dp, Color.DarkGray),\n264\t        shape = RoundedCornerShape(12.dp)\n265\t    ) {\n266\t        Column(modifier = Modifier.padding(8.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {\n267\t            Row(\n268\t                modifier = Modifier.fillMaxWidth(),\n269\t                horizontalArrangement = Arrangement.SpaceBetween,\n270\t                verticalAlignment = Alignment.CenterVertically\n271\t            ) {\n272\t                IconButton(\n273\t                    onClick = { onMonthChange(visibleMonth.minusMonths(1)) },\n274\t                    modifier = Modifier.size(28.dp)\n275\t                ) {\n276\t                    Text(\"◀\", fontSize = 14.sp, color = primaryColor)\n277\t                }\n278\t\n279\t                // Строка «Месяц Год» с возможностью выбора года\n280\t                var showYearPicker by remember { mutableStateOf(false) }\n281\t                val monthName = MonthlyNorms.MONTH_NAMES_NOMINATIVE[visibleMonth.monthValue - 1]\n282\t                Text(\n283\t                    text = \"$monthName ${visibleMonth.year}\",\n284\t                    fontSize = 14.sp,\n285\t                    fontWeight = FontWeight.Bold,\n286\t                    modifier = Modifier.clickable { showYearPicker = true }\n287\t                )\n288\t\n289\t                if (showYearPicker) {\n290\t                    val currentYear = visibleMonth.year\n291\t                    val years = (currentYear - 5)..(currentYear + 5)\n292\t                    AlertDialog(\n293\t                        onDismissRequest = { showYearPicker = false },\n294\t                        title = { Text(\"Выберите год\", fontSize = 14.sp) },\n295\t                        text = {\n296\t                            Column {\n297\t                                years.toList().chunked(3).forEach { rowYears ->\n298\t                                    Row(\n299\t                                        horizontalArrangement = Arrangement.spacedBy(6.dp),\n300\t                                        modifier = Modifier.fillMaxWidth().padding(vertical = 2.dp)\n301\t                                    ) {\n302\t                                        rowYears.forEach { year ->\n303\t                                            val isSelected = year == visibleMonth.year\n304\t                                            Button(\n305\t                                                onClick = {\n306\t                                                    onMonthChange(YearMonth.of(year, visibleMonth.monthValue))\n307\t                                                    showYearPicker = false\n308\t                                                },\n309\t                                                colors = ButtonDefaults.buttonColors(\n310\t                                                    containerColor = if (isSelected) primaryColor else Color.DarkGray\n311\t                                                ),\n312\t                                                modifier = Modifier.weight(1f).height(36.dp),\n313\t                                                contentPadding = PaddingValues(0.dp)\n314\t                                            ) {\n315\t                                                Text(\n316\t                                                    year.toString(),\n317\t                                                    fontSize = 13.sp,\n318\t                                                    fontWeight = if (isSelected) FontWeight.Bold else FontWeight.Normal,\n319\t                                                    color = if (isSelected) Color.Black else Color.White\n320\t                                                )\n321\t                                            }\n322\t                                        }\n323\t                                        repeat(3 - rowYears.size) { Spacer(modifier = Modifier.weight(1f)) }\n324\t                                    }\n325\t                                }\n326\t                            }\n327\t                        },\n328\t                        confirmButton = {}\n329\t                    )\n330\t                }\n331\t\n332\t                IconButton(\n333\t                    onClick = { onMonthChange(visibleMonth.plusMonths(1)) },\n334\t                    modifier = Modifier.size(28.dp)\n335\t                ) {\n336\t                    Text(\"▶\", fontSize = 14.sp, color = primaryColor)\n337\t                }\n338\t            }\n339\t\n340\t            HorizontalPager(\n341\t                state = pagerState,\n342\t                key = { it }, // явное указание ключа (по умолчанию индекс, но для надёжности)\n343\t                modifier = Modifier.fillMaxWidth()\n344\t            ) { page ->\n345\t                val monthForPage = remember(page) {\n346\t                    baseMonth.plusMonths((page - initialPage).toLong())\n347\t                }\n348\t                MonthGrid(\n349\t                    month = monthForPage,\n350\t                    brigade = selectedBrigade,\n351\t                    today = today,\n352\t                    morningColor = morningColor,\n353\t                    dayColor = dayColor,\n354\t                    nightColor = nightColor,\n355\t                    offColor = offColor,\n356\t                    primaryColor = primaryColor\n357\t                )\n358\t            }\n359\t        }\n360\t    }\n361\t}\n362\t\n363\t@Composable\n364\tfun MonthGrid(\n365\t    month: YearMonth,\n366\t    brigade: Int,\n367\t    today: LocalDate,\n368\t    morningColor: Color,\n369\t    dayColor: Color,\n370\t    nightColor: Color,\n371\t    offColor: Color,\n372\t    primaryColor: Color\n373\t) {\n374\t    val weekDays = listOf(\"Пн\", \"Вт\", \"Ср\", \"Чт\", \"Пт\", \"Сб\", \"Вс\")\n375\t    val firstDayOfMonth = month.atDay(1)\n376\t    val daysInMonth = month.lengthOfMonth()\n377\t    val emptySlotsBefore = firstDayOfMonth.dayOfWeek.value - 1\n378\t    val totalCells = emptySlotsBefore + daysInMonth\n379\t    val rows = (totalCells + 6) / 7\n380\t\n381\t    // Вычисляем даты зарплаты и аванса (сдвигаем на пятницу если выпадает на выходные)\n382\t    fun payDate(day: Int): LocalDate {\n383\t        var d = month.atDay(day.coerceAtMost(daysInMonth))\n384\t        while (d.dayOfWeek.value > 5) d = d.minusDays(1) // Сб=6, Вс=7 → пятница\n385\t        return d\n386\t    }\n387\t    val salaryDate = payDate(10)\n388\t    val advanceDate = payDate(25)\n389\t\n390\t    fun getColorForShift(shift: ShiftType): Color {\n391\t        return when (shift) {\n392\t            ShiftType.MORNING -> morningColor\n393\t            ShiftType.DAY -> dayColor\n394\t            ShiftType.NIGHT -> nightColor\n395\t            ShiftType.OFF -> offColor\n396\t        }\n397\t    }\n398\t\n399\t    Column(verticalArrangement = Arrangement.spacedBy(1.dp)) {\n400\t        Row(\n401\t            modifier = Modifier.fillMaxWidth(),\n402\t            horizontalArrangement = Arrangement.SpaceBetween\n403\t        ) {\n404\t            weekDays.forEach { day ->\n405\t                Text(\n406\t                    text = day,\n407\t                    fontSize = 9.sp,\n408\t                    fontWeight = FontWeight.Bold,\n409\t                    color = if (day == \"Сб\" || day == \"Вс\") Color(0xFFFF5252) else Color.Gray,\n410\t                    modifier = Modifier.weight(1f),\n411\t                    textAlign = TextAlign.Center\n412\t                )\n413\t            }\n414\t        }\n415\t\n416\t        for (row in 0 until rows) {\n417\t            Row(\n418\t                modifier = Modifier.fillMaxWidth(),\n419\t                horizontalArrangement = Arrangement.SpaceBetween\n420\t            ) {\n421\t                for (col in 0 until 7) {\n422\t                    val cellIndex = row * 7 + col\n423\t                    val dayNumber = cellIndex - emptySlotsBefore + 1\n424\t\n425\t                    if (dayNumber in 1..daysInMonth) {\n426\t                        val date = month.atDay(dayNumber)\n427\t                        val shift = ShiftSchedule.shiftFor(date, brigade)\n428\t                        val isToday = date == today\n429\t                        val color = getColorForShift(shift)\n430\t                        val isSalary = date == salaryDate\n431\t                        val isAdvance = date == advanceDate\n432\t\n433\t                        Box(\n434\t                            modifier = Modifier\n435\t                                .weight(1f)\n436\t                                .aspectRatio(1f)\n437\t                                .padding(1.dp)\n438\t                                .background(\n439\t                                    color = when {\n440\t                                        isSalary -> Color(0xFFFFD600).copy(alpha = 0.25f)\n441\t                                        isAdvance -> Color(0xFF00BFA5).copy(alpha = 0.25f)\n442\t                                        else -> color.copy(alpha = 0.85f)\n443\t                                    },\n444\t                                    shape = RoundedCornerShape(4.dp)\n445\t                                )\n446\t                                .border(\n447\t                                    width = when {\n448\t                                        isToday -> 2.dp\n449\t                                        isSalary || isAdvance -> 2.5.dp\n450\t                                        else -> 0.5.dp\n451\t                                    },\n452\t                                    color = when {\n453\t                                        isToday -> primaryColor\n454\t                                        isSalary -> Color(0xFFFFD600)\n455\t                                        isAdvance -> Color(0xFF00BFA5)\n456\t                                        else -> Color.Transparent\n457\t                                    },\n458\t                                    shape = RoundedCornerShape(4.dp)\n459\t                                ),\n460\t                            contentAlignment = Alignment.Center\n461\t                        ) {\n462\t                            Column(\n463\t                                horizontalAlignment = Alignment.CenterHorizontally,\n464\t                                verticalArrangement = Arrangement.Center\n465\t                            ) {\n466\t                                Text(\n467\t                                    text = \"$dayNumber\",\n468\t                                    fontSize = if (isToday) 10.sp else 9.sp,\n469\t                                    fontWeight = if (isToday) FontWeight.ExtraBold else FontWeight.Bold,\n470\t                                    color = if (shift == ShiftType.NIGHT) Color.White else Color.Black\n471\t                                )\n472\t                                if (isSalary || isAdvance) {\n473\t                                    Text(\n474\t                                        text = if (isSalary) \"💰\" else \"💵\",\n475\t                                        fontSize = 12.sp\n476\t                                    )\n477\t                                    Text(\n478\t                                        text = if (isSalary) \"ЗП\" else \"АВ\",\n479\t                                        fontSize = 8.sp,\n480\t                                        fontWeight = FontWeight.ExtraBold,\n481\t                                        color = if (isSalary) Color(0xFFFFD600) else Color(0xFF00BFA5)\n482\t                                    )\n483\t                                } else {\n484\t                                    Text(\n485\t                                        text = shift.shortName,\n486\t                                        fontSize = 7.sp,\n487\t                                        fontWeight = FontWeight.ExtraBold,\n488\t                                        color = if (shift == ShiftType.NIGHT) Color.White.copy(alpha = 0.7f) else Color.DarkGray\n489\t                                    )\n490\t                                }\n491\t                            }\n492\t                        }\n493\t                    } else {\n494\t                        Spacer(modifier = Modifier.weight(1f).padding(1.dp))\n495\t                    }\n496\t                }\n497\t            }\n498\t        }\n499\t    }\n500\t}\n501\t\n502\t// ==========================================\n503\t// ИТОГИ МЕСЯЦА (УМЕНЬШЕННАЯ КАРТОЧКА)\n504\t// ==========================================\n505\t\n506\t@Composable\n507\tfun MonthlyStatsCard(\n508\t    visibleMonth: YearMonth,\n509\t    selectedBrigade: Int\n510\t) {\n511\t    val monthIndex = visibleMonth.monthValue - 1\n512\t    val monthInfo = MonthlyNorms.list[monthIndex]\n513\t    val normVal = monthInfo.norm\n514\t\n515\t    var workDays = 0.0\n516\t    var holidayHours = 0.0\n517\t    var nightCount = 0\n518\t    var dayCount = 0\n519\t    var morningCount = 0\n520\t    val fixedHolidays = listOf(\n521\t        java.time.MonthDay.of(1, 1),\n522\t        java.time.MonthDay.of(1, 7),\n523\t        java.time.MonthDay.of(3, 8),\n524\t        java.time.MonthDay.of(5, 1),\n525\t        java.time.MonthDay.of(5, 9),\n526\t        java.time.MonthDay.of(7, 3),\n527\t        java.time.MonthDay.of(11, 7),\n528\t        java.time.MonthDay.of(12, 25)\n529\t    )\n530\t\n531\t    for (day in 1..visibleMonth.lengthOfMonth()) {\n532\t        val date = visibleMonth.atDay(day)\n533\t        val shift = ShiftSchedule.shiftFor(date, selectedBrigade)\n534\t        when (shift) {\n535\t            ShiftType.OFF -> {}\n536\t            else -> {\n537\t                workDays += 1.0\n538\t                if (fixedHolidays.contains(java.time.MonthDay.from(date))) {\n539\t                    holidayHours += 8.0\n540\t                }\n541\t                when (shift) {\n542\t                    ShiftType.NIGHT -> nightCount++\n543\t                    ShiftType.DAY -> dayCount++\n544\t                    ShiftType.MORNING -> morningCount++\n545\t                    else -> {}\n546\t                }\n547\t            }\n548\t        }\n549\t    }\n550\t    val factHours = workDays * 8.0\n551\t\n552\t    Card(\n553\t        modifier = Modifier.fillMaxWidth(),\n554\t        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n555\t        border = BorderStroke(0.5.dp, Color(0xFF00E676)),\n556\t        shape = RoundedCornerShape(6.dp)\n557\t    ) {\n558\t        Column(\n559\t            modifier = Modifier.padding(horizontal = 8.dp, vertical = 6.dp),\n560\t            verticalArrangement = Arrangement.spacedBy(2.dp)\n561\t        ) {\n562\t            Text(\n563\t                text = \"📊 Итоги\",\n564\t                fontSize = 10.sp,\n565\t                fontWeight = FontWeight.Bold,\n566\t                color = Color(0xFF00E676)\n567\t            )\n568\t\n569\t            Row(\n570\t                modifier = Modifier.fillMaxWidth(),\n571\t                horizontalArrangement = Arrangement.SpaceBetween\n572\t            ) {\n573\t                CompactStatItem(\"Норма\", \"${normVal.toInt()} ч\")\n574\t                CompactStatItem(\"Факт\", \"${factHours.toInt()} ч\")\n575\t                CompactStatItem(\"Праздн.\", \"${holidayHours.toInt()} ч\")\n576\t            }\n577\t\n578\t            Row(\n579\t                modifier = Modifier.fillMaxWidth(),\n580\t                horizontalArrangement = Arrangement.SpaceBetween\n581\t            ) {\n582\t                CompactStatItem(\"Ночные\", nightCount.toString())\n583\t                CompactStatItem(\"Дневные\", dayCount.toString())\n584\t                CompactStatItem(\"Утренние\", morningCount.toString())\n585\t            }\n586\t        }\n587\t    }\n588\t}\n589\t\n590\t@Composable\n591\tfun CompactStatItem(label: String, value: String) {\n592\t    Column(horizontalAlignment = Alignment.CenterHorizontally) {\n593\t        Text(\n594\t            text = label,\n595\t            fontSize = 8.sp,\n596\t            color = Color.Gray\n597\t        )\n598\t        Text(\n599\t            text = value,\n600\t            fontSize = 10.sp,\n601\t            fontWeight = FontWeight.Bold\n602\t        )\n603\t    }\n604\t}"
                }
