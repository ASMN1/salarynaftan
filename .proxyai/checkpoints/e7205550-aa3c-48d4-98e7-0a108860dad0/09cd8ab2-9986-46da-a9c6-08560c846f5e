                    "text": "Note: Content truncated. Use offset parameter to read more lines.\n\n363\t@Composable\n364\tfun MonthGrid(\n365\t    month: YearMonth,\n366\t    brigade: Int,\n367\t    today: LocalDate,\n368\t    morningColor: Color,\n369\t    dayColor: Color,\n370\t    nightColor: Color,\n371\t    offColor: Color,\n372\t    primaryColor: Color\n373\t) {\n374\t    val weekDays = listOf(\"Пн\", \"Вт\", \"Ср\", \"Чт\", \"Пт\", \"Сб\", \"Вс\")\n375\t    val firstDayOfMonth = month.atDay(1)\n376\t    val daysInMonth = month.lengthOfMonth()\n377\t    val emptySlotsBefore = firstDayOfMonth.dayOfWeek.value - 1\n378\t    val totalCells = emptySlotsBefore + daysInMonth\n379\t    val rows = (totalCells + 6) / 7\n380\t\n381\t    // Вычисляем даты зарплаты и аванса (сдвигаем на пятницу если выпадает на выходные)\n382\t    fun payDate(day: Int): LocalDate {\n383\t        var d = month.atDay(day.coerceAtMost(daysInMonth))\n384\t        while (d.dayOfWeek.value > 5) d = d.minusDays(1) // Сб=6, Вс=7 → пятница\n385\t        return d\n386\t    }\n387\t    val salaryDate = payDate(10)\n388\t    val advanceDate = payDate(25)\n389\t\n390\t    fun getColorForShift(shift: ShiftType): Color {\n391\t        return when (shift) {\n392\t            ShiftType.MORNING -> morningColor\n393\t            ShiftType.DAY -> dayColor\n394\t            ShiftType.NIGHT -> nightColor\n395\t            ShiftType.OFF -> offColor\n396\t        }\n397\t    }\n398\t\n399\t    Column(verticalArrangement = Arrangement.spacedBy(1.dp)) {\n400\t        Row(\n401\t            modifier = Modifier.fillMaxWidth(),\n402\t            horizontalArrangement = Arrangement.SpaceBetween\n403\t        ) {\n404\t            weekDays.forEach { day ->\n405\t                Text(\n406\t                    text = day,\n407\t                    fontSize = 9.sp,\n408\t                    fontWeight = FontWeight.Bold,\n409\t                    color = if (day == \"Сб\" || day == \"Вс\") Color(0xFFFF5252) else Color.Gray,\n410\t                    modifier = Modifier.weight(1f),\n411\t                    textAlign = TextAlign.Center\n412\t                )\n413\t            }\n414\t        }\n415\t\n416\t        for (row in 0 until rows) {\n417\t            Row(\n418\t                modifier = Modifier.fillMaxWidth(),\n419\t                horizontalArrangement = Arrangement.SpaceBetween\n420\t            ) {\n421\t                for (col in 0 until 7) {\n422\t                    val cellIndex = row * 7 + col\n423\t                    val dayNumber = cellIndex - emptySlotsBefore + 1\n424\t\n425\t                    if (dayNumber in 1..daysInMonth) {\n426\t                        val date = month.atDay(dayNumber)\n427\t                        val shift = ShiftSchedule.shiftFor(date, brigade)\n428\t                        val isToday = date == today\n429\t                        val color = getColorForShift(shift)\n430\t                        val isSalary = date == salaryDate\n431\t                        val isAdvance = date == advanceDate\n432\t\n433\t                        Box(\n434\t                            modifier = Modifier\n435\t                                .weight(1f)\n436\t                                .aspectRatio(1f)\n437\t                                .padding(1.dp)\n438\t                                .background(\n439\t                                    color = color.copy(alpha = 0.85f),\n440\t                                    shape = RoundedCornerShape(4.dp)\n441\t                                )\n442\t                                .border(\n443\t                                    width = when {\n444\t                                        isToday -> 2.dp\n445\t                                        isSalary || isAdvance -> 1.5.dp\n446\t                                        else -> 0.5.dp\n447\t                                    },\n448\t                                    color = when {\n449\t                                        isToday -> primaryColor\n450\t                                        isSalary -> Color(0xFFFFD600)\n451\t                                        isAdvance -> Color(0xFF00BFA5)\n452\t                                        else -> Color.Transparent\n453\t                                    },\n454\t                                    shape = RoundedCornerShape(4.dp)\n455\t                                ),\n456\t                            contentAlignment = Alignment.Center\n457\t                        ) {\n458\t                            Column(\n459\t                                horizontalAlignment = Alignment.CenterHorizontally,\n460\t                                verticalArrangement = Arrangement.Center\n461\t                            ) {\n462\t                                Text(\n463\t                                    text = \"$dayNumber\",\n464\t                                    fontSize = if (isToday) 10.sp else 9.sp,\n465\t                                    fontWeight = if (isToday) FontWeight.ExtraBold else FontWeight.Bold,\n466\t                                    color = if (shift == ShiftType.NIGHT) Color.White else Color.Black\n467\t                                )\n468\t                                Text(\n469\t                                    text = when {\n470\t                                        isSalary -> \"💰\"\n471\t                                        isAdvance -> \"💵\"\n472\t                                        else -> shift.shortName\n473\t                                    },\n474\t                                    fontSize = 7.sp,\n475\t                                    fontWeight = FontWeight.ExtraBold,\n476\t                                    color = when {\n477\t                                        isSalary -> Color(0xFFFFD600)\n478\t                                        isAdvance -> Color(0xFF00BFA5)\n479\t                                        shift == ShiftType.NIGHT -> Color.White.copy(alpha = 0.7f)\n480\t                                        else -> Color.DarkGray\n481\t                                    }\n482\t                                )\n483\t                            }\n484\t                        }\n485\t                    } else {\n486\t                        Spacer(modifier = Modifier.weight(1f).padding(1.dp))\n487\t                    }\n488\t                }\n489\t            }\n490\t        }\n491\t    }\n492\t}\n493\t\n494\t// ==========================================\n495\t// ИТОГИ МЕСЯЦА (УМЕНЬШЕННАЯ КАРТОЧКА)\n496\t// ==========================================\n497"
