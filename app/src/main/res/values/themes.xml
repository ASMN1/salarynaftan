<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Salarynaftan" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- ===== Стили полномесячного виджета (в стиле экрана «График») ===== -->
    <style name="WidgetDayCell" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:layout_margin">0.5dp</item>
        <item name="android:background">@drawable/widget_cell_round</item>
    </style>

    <style name="WidgetDayNum" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">none</item>
    </style>

    <style name="WidgetDayShift" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">none</item>
    </style>

    <style name="WidgetWeekdayCell" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">7sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#99FFFFFF</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Анимированная splash-тема для Android 12+ SplashScreen API -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#121212</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenAnimationDuration">1200</item>
        <item name="windowSplashScreenIconBackgroundColor">#00E676</item>
        <item name="postSplashScreenTheme">@style/Theme.Salarynaftan</item>
    </style>

</resources>
