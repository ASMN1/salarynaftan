<?xml version="1.0" encoding="utf-8"?>
<!--
   Правила резервного копирования для Android 12+ (android:dataExtractionRules).
   Резервируем пользовательские данные приложения:
   - БД Room (salarynaftan.db, истории и данные месяцев);
   - SharedPreferences (настройки будильников, бригады, авто-тишины);
   - DataStore Preferences (settings.preferences_pb).
   Кэш экспортов не входит в include, поэтому не бэкапится (воспроизводится заново).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="salarynaftan.db" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="salarynaftan.db" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
