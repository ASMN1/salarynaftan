<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Все экспортируемые файлы (PDF/PNG/CSV/ICS) пишутся в cacheDir/exports.
         Доступа к filesDir/external не требуется — ничего туда не пишется.
         Поэтому открыт только узкий cache-path на подпапку exports. -->
    <cache-path
        name="exports"
        path="exports/" />
</paths>
